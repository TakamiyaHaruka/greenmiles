# GreenMiles Environment Variables
# Copy this file to .env.local and fill in the values

# JWT Secret for authentication (required)
# Generate a random secret: openssl rand -base64 32
JWT_SECRET=your-secret-here

# Database path (optional, defaults to ./greenmiles.db)
# DATABASE_PATH=./greenmiles.db

# Admin console password for /admin (optional — omit to disable the console)
# Generate a random password: openssl rand -hex 12
# ADMIN_PASSWORD=change-me
